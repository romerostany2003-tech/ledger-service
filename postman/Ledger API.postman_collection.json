{
  "info": {
    "_postman_id": "6df9bf73-233d-4e65-bcb4-0f885392ad86",
    "name": "Ledger API",
    "description": "Postman collection for all currently implemented Ledger API endpoints.\n\nRun the Happy Path folder in order so the create request captures transactionId for subsequent requests. The Potential Error Cases folder contains representative validation, conflict, malformed-input, and not-found scenarios.\n\nImplemented routes:\n- POST /transactions\n- GET /transactions/{id}\n- GET /transactions/{id}/balance (the code treats {id} as an account ID)\n\nSupported currencies: INR, USD, EUR, CAD, YEN. Directions: DEBIT, CREDIT. Amounts must be at least 0.01 with at most 15 integer digits and 2 fractional digits. Transactions require at least two entries and total debits must equal total credits.\n\nNote: GET /accounts/{id}/entries and GET /trial-balance appear only in TODO.md and are therefore not included as callable endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9093", "type": "string" },
    { "key": "debitAccountId", "value": "11111111-1111-4111-8111-111111111111", "type": "string" },
    { "key": "creditAccountId", "value": "22222222-2222-4222-8222-222222222222", "type": "string" },
    { "key": "idempotencyKey", "value": "ledger-happy-path-001", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "conflictKey", "value": "ledger-conflict-001", "type": "string" },
    { "key": "unknownTransactionId", "value": "ffffffff-ffff-4fff-8fff-ffffffffffff", "type": "string" },
    { "key": "unknownAccountId", "value": "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee", "type": "string" }
  ],
  "item": [
    {
      "name": "Happy Path",
      "description": "Run these requests in order. The first request stores the returned transaction ID in the collection variable transactionId.",
      "item": [
        {
          "name": "1. Create Balanced Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "description": "Required, non-blank, maximum 255 characters." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"INR\",\n  \"reference\": \"INV-2026-0001\",\n  \"description\": \"Balanced transfer between two accounts\",\n  \"entries\": [\n    {\n      \"accountId\": \"{{debitAccountId}}\",\n      \"direction\": \"DEBIT\",\n      \"amount\": 1250.50\n    },\n    {\n      \"accountId\": \"{{creditAccountId}}\",\n      \"direction\": \"CREDIT\",\n      \"amount\": 1250.50\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/transactions",
            "description": "Creates a balanced ledger transaction. The first send with this Idempotency-Key returns 201 Created; repeating the identical request with the same key returns 200 OK and the original transaction. Change idempotencyKey manually when you want to create a new transaction. Optional reference and description may be null or omitted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 on creation or 200 on replay', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('Response contains transaction fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.currency).to.eql('INR');",
                  "  pm.expect(body.entries).to.be.an('array').with.lengthOf(2);",
                  "  pm.collectionVariables.set('transactionId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Replay Same Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"INR\",\n  \"reference\": \"INV-2026-0001\",\n  \"description\": \"Balanced transfer between two accounts\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 1250.50 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 1250.50 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/transactions",
            "description": "Reuses the same key and semantically identical payload. Expected: 200 OK with the original transaction. Entry order and numeric trailing zeros do not change the request fingerprint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK for replay', () => pm.response.to.have.status(200));",
                  "pm.test('Original transaction is returned', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transactionId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/{{transactionId}}",
            "description": "Fetches the transaction created by request 1. Expected: 200 OK."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returned ID matches', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transactionId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Get Debit Account Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/{{debitAccountId}}/balance",
            "description": "The controller path says transaction ID, but the service interprets this value as accountId. For the seeded debit account, balance = totalCredits - totalDebits. Expected: 200 OK and -1250.50 if only the happy-path transaction exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Account ID matches', () => pm.expect(pm.response.json().accountId).to.eql(pm.collectionVariables.get('debitAccountId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Get Unknown Account Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/{{unknownAccountId}}/balance",
            "description": "An unknown account is not treated as an error. Repository sums are expected to resolve to zero, producing a zero balance."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Potential Error Cases",
      "description": "Representative invalid input and domain-error scenarios. Spring validation/deserialization errors use the framework's default error body because the project only customizes 404 and 409 responses.",
      "item": [
        {
          "name": "Create - Missing Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"USD\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request because the required header is absent."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Blank Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "   " }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"USD\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request due to @NotBlank. Some HTTP clients may trim a whitespace-only header, making this equivalent to a missing header."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Idempotency-Key Over 255 Characters",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"USD\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request due to @Size(max = 255). The supplied value is 256 characters."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Missing Currency",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-missing-currency" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request because currency is required."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Unsupported Currency",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-invalid-currency" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"GBP\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request. Valid values are INR, USD, EUR, CAD, and YEN."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Only One Entry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-one-entry" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"EUR\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request. At least two entries are required. An omitted or null entries property is also invalid."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Invalid Account UUID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-invalid-account-uuid" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"CAD\",\n  \"entries\": [\n    { \"accountId\": \"not-a-uuid\", \"direction\": \"DEBIT\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request during JSON deserialization. Null or omitted accountId is also invalid."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Invalid Direction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-invalid-direction" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"YEN\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"WITHDRAWAL\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request. Valid directions are DEBIT and CREDIT. Null or omitted direction is also invalid."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Zero Amount",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-zero-amount" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"INR\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 0 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 0 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request. Amount must be at least 0.01. Negative and null amounts are also invalid."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Amount Has Too Many Decimal Places",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-amount-scale" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"USD\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.001 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.001 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request because the request DTO allows at most 2 fractional digits and 15 integer digits."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Create - Reference and Description Too Long",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-field-length" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"USD\",\n  \"reference\": \"{{overlongReference}}\",\n  \"description\": \"{{overlongDescription}}\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 10.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 10.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 400 Bad Request. The pre-request script supplies a 256-character reference and a 501-character description."
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.variables.set('overlongReference', 'R'.repeat(256));", "pm.variables.set('overlongDescription', 'D'.repeat(501));"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }
          ]
        },
        {
          "name": "Create - Unbalanced Debits and Credits",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "error-unbalanced" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"INR\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 100.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 90.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Current behavior: likely 500 Internal Server Error because LedgerTransaction.create throws an IllegalArgumentException and GlobalExceptionHandler does not map it. Desired API behavior would normally be 400 Bad Request."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Current implementation returns 500', () => pm.response.to.have.status(500));"] } }]
        },
        {
          "name": "Idempotency Conflict - 1. Seed Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{conflictKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"EUR\",\n  \"reference\": \"CONFLICT-SEED\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 25.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 25.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Creates the original transaction for the following conflict request. On the first run expect 201; on later runs with the same collection variable expect 200 replay."
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('conflictKey', `ledger-conflict-${Date.now()}-${pm.variables.replaceIn('{{$guid}}')}`);"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201 Created', () => pm.response.to.have.status(201));"] } }
          ]
        },
        {
          "name": "Idempotency Conflict - 2. Reuse Key with Different Payload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{conflictKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"EUR\",\n  \"reference\": \"DIFFERENT-PAYLOAD\",\n  \"entries\": [\n    { \"accountId\": \"{{debitAccountId}}\", \"direction\": \"DEBIT\", \"amount\": 30.00 },\n    { \"accountId\": \"{{creditAccountId}}\", \"direction\": \"CREDIT\", \"amount\": 30.00 }\n  ]\n}" },
            "url": "{{baseUrl}}/transactions",
            "description": "Expected: 409 Conflict with custom ErrorResponse because the same key is paired with a different request fingerprint. Run the seed request first."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));", "pm.test('Custom error body has statusCode', () => pm.expect(pm.response.json().statusCode).to.eql(409));"] } }]
        },
        {
          "name": "Get Transaction - Not Found",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/{{unknownTransactionId}}",
            "description": "Expected: 404 Not Found with custom ErrorResponse."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));", "pm.test('Custom error body has statusCode', () => pm.expect(pm.response.json().statusCode).to.eql(404));"] } }]
        },
        {
          "name": "Get Transaction - Malformed UUID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/not-a-uuid",
            "description": "Expected: 400 Bad Request because the path variable cannot be converted to UUID."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Get Balance - Malformed Account UUID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/not-a-uuid/balance",
            "description": "Expected: 400 Bad Request because the account ID path variable cannot be converted to UUID. A valid but unknown account is not an error; see the Happy Path folder."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        }
      ]
    }
  ]
}
